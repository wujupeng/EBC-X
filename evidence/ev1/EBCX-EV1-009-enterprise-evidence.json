  "pendingSemantics": {
    "description": "CommandId pending concurrency semantics (BLOCKER-01)",
    "rule": "When two concurrent requests use the same commandId, the first INSERT succeeds (status=pending), the second INSERT blocks on PRIMARY KEY constraint, then fails with 23505 (unique_violation) when the first commits. The error is caught and returned as ErrEnterpriseIdempotencyConflict (HTTP 409). If the first commits before the second starts, the second sees status=success and returns the first result (idempotent return).",
    "httpStatus": 409
  },
  "chainGenesis": {
    "description": "Chain first record concurrency semantics (TASK-AMEND-001, REQUIRED-02)",
    "rule": "Two concurrent transactions writing to the same empty chain are serialized by pg_advisory_xact_lock(hashtext(chainID)). The first transaction acquires the advisory lock, sees no existing records (sql.ErrNoRows), writes SequenceNo=1 with previousHash=GenesisHash(chainID). The second transaction blocks on the advisory lock, then acquires it after the first commits, sees SequenceNo=1, writes SequenceNo=2 with previousHash=first.evidenceHash. This is advisory lock serialization, NOT UNIQUE(chain_id, sequence_no) constraint error-driven.",
    "advisoryLockFunction": "pg_advisory_xact_lock(hashtext($chainID))",
    "taskAmend": "TASK-AMEND-001"
  },
  "implementationDefectFixes": [
