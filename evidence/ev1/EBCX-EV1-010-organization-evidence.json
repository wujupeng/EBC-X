    ],
    "moveOrder": [
      "SQL 0: Idempotency CheckAndReserve",
      "SQL 1: business.organizations 被移动 Org 行锁 SELECT FOR UPDATE",
      "SQL 2: business.organizations newParent 只读查询",
      "SQL 3: GetSubtree 递归 CTE (只读)",
      "SQL 4: CAS UPDATE 被移动 Org (parent_id, level, version+1)",
      "SQL 5: 批量 UPDATE descendant level (不递增 version, R1.3)",
      "SQL 6: Chain 1 Advisory Lock (organization-mutation-chain)",
      "SQL 7: Chain 1 Evidence predecessor SELECT FOR UPDATE",
      "SQL 8: Chain 1 Evidence INSERT (Organization MOVE)",
      "SQL 9: Chain 2 Advisory Lock (organization-tree-structural-chain)",
      "SQL 10: Chain 2 Evidence predecessor SELECT FOR UPDATE",
      "SQL 11: Chain 2 Evidence INSERT (OrganizationTree SUBTREE_STRUCTURAL_UPDATE)",
      "SQL 12: Outbox INSERT",
      "SQL 13: Idempotency MarkSuccess",
      "COMMIT"
    ]
  },
  "pendingSemantics": {
    "description": "CommandId pending concurrency semantics (BLOCKER-01, reuse EV1-009 pattern)",
    "rule": "When two concurrent requests use the same commandId, the first INSERT succeeds (status=pending), the second INSERT blocks on PRIMARY KEY constraint, then fails with 23505 (unique_violation). The error is caught and returned as ErrOrgIdempotencyConflict (HTTP 409).",
    "httpStatus": 409
  },
  "chainGenesis": {
    "description": "2 independent chains with advisory lock serialization",
    "chain1": "organization-mutation-chain-{tenantId} (Organization Mutation Evidence)",
    "chain2": "organization-tree-structural-chain-{tenantId} (Subtree Structural Evidence)",
    "advisoryLockFunction": "pg_advisory_xact_lock(hashtext($chainID))",
    "lockOrder": "MoveOrganization: chain 1 first, then chain 2 (prevent deadlock)"
  },
